{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist/mjs",
    "emitDeclarationOnly": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "esnext"
  },
  "exclude": ["node_modules"],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
